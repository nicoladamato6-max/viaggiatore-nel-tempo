# Variabili d'ambiente per l'ambiente di test (staging).
# NON committare mai questo file con valori reali.
# Configurare come "Variables & Secrets" nel progetto Cloudflare Pages:
#   https://dash.cloudflare.com → Workers & Pages → test-viaggiatore-nel-tempo → Settings → Variables

# ── Supabase (progetto separato per staging) ──────────────────────────────────
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<staging-anon-key>

# ── MapTiler ──────────────────────────────────────────────────────────────────
# Usare la stessa chiave di produzione o una dedicata (quota separata consigliata)
VITE_MAPTILER_KEY=<maptiler-api-key>

# ── Autenticazione Basic Auth (solo staging) ──────────────────────────────────
# Configurare come "Secret" (non come Variable) nel CF Pages dashboard
ENVIRONMENT=staging
BASIC_AUTH_USER=<username>
BASIC_AUTH_PASS=<password>

# ── GitHub Actions Secrets richiesti ──────────────────────────────────────────
# Aggiungere nelle Repository Secrets (Settings → Secrets → Actions):
#   CLOUDFLARE_API_TOKEN      — token CF con permesso Pages:Edit
#   CLOUDFLARE_ACCOUNT_ID     — ID account Cloudflare
#   VITE_MAPTILER_KEY         — (già presente per prod)
#   VITE_SUPABASE_URL_STAGING — URL del progetto Supabase staging
#   VITE_SUPABASE_ANON_KEY_STAGING — chiave anonima Supabase staging
