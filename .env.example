# ── Cesium Ion ────────────────────────────────────────────────
# Token gratuito: https://cesium.com/ion/tokens
VITE_CESIUM_TOKEN=your_cesium_ion_token_here

# ── Supabase ──────────────────────────────────────────────────
# Crea un progetto su https://supabase.com (gratuito)
# Settings → API → Project URL + anon/public key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Cloudflare Pages (variabili server-side) ─────────────────
# Aggiungile in: Cloudflare Pages → Settings → Environment Variables
# NON aggiungere al .env.local — sono solo server-side

# SUPABASE_JWT_SECRET=your_jwt_secret    # Settings → API → JWT Secret
# SUPABASE_SERVICE_ROLE_KEY=your_svc_key # Settings → API → service_role
# SUPABASE_URL=https://your-project.supabase.co
